# Copy to .env and fill in. docker compose reads .env automatically.

# --------------------------------------------
# STORAGE: CLOUDFLARE R2
# --------------------------------------------
# R2 > Manage API tokens > Create token with "Object Read & Write" on the bucket.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=we-capture

# Optional: S3-compatible endpoint override for local testing (MinIO, moto).
# Leave empty to use https://<R2_ACCOUNT_ID>.r2.cloudflarestorage.com
R2_ENDPOINT=

# Public URL the QR code points to (no trailing slash). Must be reachable from
# visitors' phones, so not localhost.
PUBLIC_BASE_URL=https://wecapture.geoplanph.com

# Leads CSV. Keep it on the /data volume in Docker so it survives restarts.
LEADS_CSV_PATH=/data/leads.csv
